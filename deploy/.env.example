# 複製為 .env 後修改：cp .env.example .env
# .env 內含機密，絕對不要提交進 git（已在 .gitignore 排除）

# ============================================================
# 網域
# ============================================================
# n8n 要使用的網域（不含 https://）。
# 此站台為內網專用：需在公司內部 DNS 建立此名稱指向本機內網 IP，
# 不需要（也無法）對外開放 80/443 給 Let's Encrypt。
N8N_DOMAIN=skcn8n.skycloud.tw

# TLS 憑證不使用 ACME 自動簽發，改載入公司 *.skycloud.tw 萬用憑證。
# 請把憑證放到 deploy/certs/：
#   certs/fullchain.pem  （伺服器憑證 + 中繼憑證）
#   certs/privkey.pem    （私鑰，chmod 600）
# 詳見 Caddyfile 開頭說明。

# n8n 映像版本。升級時改這裡，再 docker compose pull && docker compose up -d
# 可選版本：https://hub.docker.com/r/n8nio/n8n/tags
N8N_VERSION=2.42.2

# ============================================================
# 時區
# ============================================================
# 影響排程觸發（Cron）的預設時區。台灣請用 Asia/Taipei
TZ=Asia/Taipei

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_USER=n8n
# 請用強密碼，可用 `openssl rand -base64 32` 產生
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=n8n

# ============================================================
# 執行紀錄保存
# ============================================================
# 保留幾小時的執行紀錄（336 = 14 天）
EXECUTIONS_DATA_MAX_AGE=336
# 最多保留幾筆執行紀錄
EXECUTIONS_DATA_PRUNE_MAX_COUNT=20000

# ============================================================
# 安全
# ============================================================
# 是否允許安裝社群節點（npm 套件）。公司內若需高度管控可設 false。
N8N_COMMUNITY_PACKAGES_ENABLED=true

# Log 等級：error / warn / info / debug
N8N_LOG_LEVEL=info

# ============================================================
# Email / SMTP（選用）
# ============================================================
# 留空 = 停用寄信。要啟用請填 smtp，並補上下方欄位。
# 未設定時：仍可用 Email+密碼登入，但無法寄送使用者邀請與密碼重設信。
N8N_EMAIL_MODE=
N8N_SMTP_HOST=
N8N_SMTP_PORT=587
N8N_SMTP_USER=
N8N_SMTP_PASS=
# 寄件者顯示，例如：n8n <n8n@example.com>
N8N_SMTP_SENDER=
# 465 埠走 SSL 時設 true
N8N_SMTP_SSL=false
# 587 埠走 STARTTLS 時設 true
N8N_SMTP_STARTTLS=true

# ============================================================
# Enterprise 授權（選用，留空 = 社群版）
# ============================================================
N8N_LICENSE_ACTIVATION_KEY=
